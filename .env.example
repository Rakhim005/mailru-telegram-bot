# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAAA-ваш-токен

# ID группы, куда слать уведомления (для групп обычно начинается с -100)
TELEGRAM_CHAT_ID=-1001234567890

# Адрес почтового ящика Mail.ru
MAILRU_USER=example@mail.ru

# Пароль для внешнего приложения (НЕ основной пароль от почты!)
MAILRU_APP_PASSWORD=ваш-пароль-приложения
